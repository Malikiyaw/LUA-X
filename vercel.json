{
  "version": 2,
  "buildCommand": "npm run build --workspace=@lua-x/web",
  "outputDirectory": "apps/web/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
