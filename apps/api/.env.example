# Copy these into your runtime/deployment secrets. Never commit the real values.
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
NVIDIA_API_KEY=
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=60000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
CORS_ORIGIN=http://127.0.0.1:3000

# Optional but recommended for production Studio presence/commands on Vercel.
# Without these, the Studio bridge uses an in-memory fallback and may reset on a cold function.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
