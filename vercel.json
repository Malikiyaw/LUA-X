{
  "version": 2,
  "buildCommand": "npm run sync:plugin && npm run build --workspace=@lua-x/web",
  "outputDirectory": "apps/web/public",
  "rewrites": [
    { "source": "/api/studio/:path*", "destination": "/api/studio" },
    { "source": "/api/ai/generate", "destination": "/api/ai/generate" },
    { "source": "/api/ai/status", "destination": "/api/ai/status" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/LUA-X.lua",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"LUA-X.lua\"" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/download/LUA-X.lua",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"LUA-X.lua\"" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
