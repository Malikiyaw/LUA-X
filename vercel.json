{
  "version": 2,
  "buildCommand": "npm run sync:plugin && npm run build --workspace=@lua-x/web",
  "outputDirectory": "apps/web/public",
  "functions": {
    "api/index.ts": { "runtime": "nodejs22.x", "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/LUA-X.plugin.lua",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"LUA-X.plugin.lua\"" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
