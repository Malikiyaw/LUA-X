{
  "name": "@lua-x/desktop-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "LUA-X Local Agent — native Roblox Studio MCP client",
  "bin": { "lua-x": "./bin/lua-x.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts --help",
    "agent": "node dist/index.js",
    "check:mcp": "node dist/index.js --check-mcp",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@lua-x/roblox-mcp-bridge": "0.1.0",
    "@lua-x/sync-engine": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "tsx": "^4.19.0"
  }
}
